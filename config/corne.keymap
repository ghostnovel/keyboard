#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // ──────────────────────────────────────────
        // СЛОЙ 0: Основной (QWERTY)
        // ──────────────────────────────────────────
        default_layer {
            bindings = <
    &kp ESC   &kp Q    &kp W    &kp E    &kp R    &kp T          &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BSPC
    &kp TAB   &kp A    &kp S    &kp D    &kp F    &kp G          &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp RET
    &kp LSHFT &kp Z    &kp X    &kp C    &kp V    &kp B          &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                       &kp LCTRL  &mo 1  &kp SPACE               &kp SPACE  &mo 2  &kp RCTRL
            >;
        };

        // ──────────────────────────────────────────
        // СЛОЙ 1: Цифры, стрелки, F-клавиши
        // ──────────────────────────────────────────
        lower_layer {
            bindings = <
    &kp GRAVE &kp N1    &kp N2  &kp N3  &kp N4   &kp N5         &kp N6  &kp N7  &kp N8   &kp N9  &kp N0  &kp BSPC
    &trans    &kp F1    &kp F2  &kp F3  &kp F4   &kp F5         &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PIPE &kp RET
    &trans    &kp F6    &kp F7  &kp F8  &kp F9   &kp F10        &kp HOME &kp END  &kp PG_DN &kp PG_UP &trans   &kp BSLH
                       &trans   &trans  &trans                   &trans  &trans   &trans
            >;
        };

        // ──────────────────────────────────────────
        // СЛОЙ 2: Символы, F11-F12
        // ──────────────────────────────────────────
        upper_layer {
            bindings = <
    &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET       &kp AMPS &kp ASTRK &kp LPRN &kp RPRN &kp MINUS &kp DEL
    &trans   &kp F11 &kp F12 &trans &trans &trans              &trans &kp LBRC &kp RBRC &kp EQL &kp TILDE &kp RET
    &trans   &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
                       &trans &trans &trans                      &trans &trans &trans
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        lang_cs: lang_cs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp LSHFT>;
        };
        lang_as: lang_as {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT>, <&kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // СЛОЙ 0 — ОСНОВНОЙ
        default_layer {
            bindings = <
    &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I    &kp O    &kp P    &kp DEL
    &kp LSHFT  &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp RET
    &kp LCTRL  &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &lang_cs
                       &kp LGUI  &kp LALT &kp SPACE             &kp BSPC &mo 2  &mo 1
            >;
        };

        // СЛОЙ 1 — НУМПАД + F-КЛАВИШИ + СИМВОЛЫ
        lower_layer {
            bindings = <
    &kp ESC    &kp N1   &kp N2   &kp N3   &kp N4   &kp N5      &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp GRAVE
    &trans     &kp F1   &kp F2   &kp F3   &kp F4   &kp F5      &kp F6   &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp DQT
    &trans     &kp F7   &kp F8   &kp F9   &kp F10  &kp F11     &kp F12  &kp BSLH &kp PIPE &kp SQT  &kp PLUS &lang_as
                       &trans    &trans    &trans               &trans   &mo 2  &mo 1
            >;
        };

        // СЛОЙ 2 — СТРЕЛКИ WASD + BT
        upper_layer {
            bindings = <
    &trans  &trans  &kp UP    &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &bt BT_CLR
    &trans  &kp LEFT &kp DOWN &kp RIGHT &trans &trans     &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
                     &trans  &trans  &trans               &trans  &mo 2  &mo 1
            >;
        };
    };
};
